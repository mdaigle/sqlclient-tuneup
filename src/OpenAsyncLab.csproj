<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SqlClientProject)" Condition="Exists('$(SqlClientProject)')" />
    <InternalsVisibleTo Include="OpenAsyncLab.Tests" />
    <None Include="..\netem_control.py" Link="netem_control.py"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\netem.py" Link="netem.py"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateSqlClientSource" BeforeTargets="PrepareForBuild;_GenerateRestoreGraphProjectEntry">
    <Error Condition="'$(SqlClientProject)' == '' or !Exists('$(SqlClientProject)')"
           Text="Set SqlClientSourceRoot to a compatible SqlClient checkout in Local.props or with -p:SqlClientSourceRoot=... . See README.md for the required driver revision." />
  </Target>
</Project>
