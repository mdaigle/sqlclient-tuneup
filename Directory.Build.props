<Project>
  <Import Project="$(MSBuildThisFileDirectory)Local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />
  <PropertyGroup>
    <SqlClientSourceRoot Condition="'$(SqlClientSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\SqlClient\src\Microsoft.Data.SqlClient\src\Microsoft.Data.SqlClient.csproj')">$(MSBuildThisFileDirectory)..\SqlClient</SqlClientSourceRoot>
    <SqlClientProject Condition="'$(SqlClientSourceRoot)' != ''">$([MSBuild]::NormalizePath('$(SqlClientSourceRoot)', 'src', 'Microsoft.Data.SqlClient', 'src', 'Microsoft.Data.SqlClient.csproj'))</SqlClientProject>
  </PropertyGroup>
</Project>
